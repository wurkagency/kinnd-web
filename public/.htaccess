# Apache settings for the static build (Plesk vhost). Copied into dist/ on build.

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # Hashed build assets and fonts never change.
  <If "%{REQUEST_URI} =~ m#^/(_astro|fonts)/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # HTML: always revalidate so a release shows up at once.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  # HTTPS only for a year. Add "; includeSubDomains" once every kinnd.eu
  # subdomain is HTTPS-only.
  Header always set Strict-Transport-Security "max-age=31536000"
  # Everything is served from this site; inline scripts and styles are Astro's own.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always unset X-Powered-By
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>

# Short URLs printed in the legal texts.
<IfModule mod_alias.c>
  RedirectMatch 301 ^/privacy/?$ /legal/privacy/
  RedirectMatch 301 ^/terms/?$ /legal/terms/
  RedirectMatch 301 ^/privatlivspolitik/?$ /da/legal/privacy/
  RedirectMatch 301 ^/vilkaar/?$ /da/legal/terms/
  RedirectMatch 301 ^/abonnementsbetingelser/?$ /da/legal/subscription/
  RedirectMatch 301 ^/subscription-terms/?$ /legal/subscription/
  RedirectMatch 301 ^/priser/?$ /da/pricing/
</IfModule>
