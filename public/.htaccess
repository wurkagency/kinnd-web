# Apache settings for the static build (Plesk vhost). Copied into dist/ on build.

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # Hashed build assets and fonts never change.
  <If "%{REQUEST_URI} =~ m#^/(_astro|fonts)/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # HTML: always revalidate so a release shows up at once.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>
