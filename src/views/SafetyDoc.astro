---
import type { MarkdownInstance } from 'astro';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import MarkdownDoc from '../components/MarkdownDoc.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { localePath, routes, useDict, type Locale } from '../i18n';

type Doc = 'encryption' | 'access' | 'abuse';
interface Props {
  lang: Locale;
  doc: Doc;
}
const { lang, doc } = Astro.props;
const t = useDict(lang);
const d = t.safety.docs;
const c = d[doc];
const routeKey = { encryption: 'safetyEncryption', access: 'safetyAccess', abuse: 'safetyAbuse' } as const;

/**
 * Technical deep dives. Text lives in src/content/safety/<lang>/<doc>.md.
 * Until a translation exists, every language shows the English text.
 */
const files = import.meta.glob<MarkdownInstance<{ title: string }>>('../content/safety/*/*.md', { eager: true });
const own = files[`../content/safety/${lang}/${doc}.md`];
const md = own ?? files[`../content/safety/en/${doc}.md`];
const bodyLang = own || lang === 'en' ? undefined : 'en';
---

<Base lang={lang} title={c.title} description={c.description} route={routes[routeKey[doc]]} current="safety">
  <PageHero title={c.heading} text={c.text}>
    <a href={localePath(lang, routes.safety)} class="back-link">
      <Icon name="arrowLeft" size={16} stroke={2} class="back-link__icon" />
      {d.back}
    </a>
  </PageHero>
  <MarkdownDoc md={md} label={c.heading.replace(/\*/g, '')} tocLabel={d.onThisPage} lang={bodyLang} />
  <CtaBand lang={lang} />
</Base>

<style>
  .back-link {
    order: -1;
    align-self: flex-start;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    color: var(--muted);
  }
  .back-link:hover {
    color: var(--forest);
    text-decoration: underline;
  }
  /* The arrow points the way back in right-to-left languages too. */
  :global([dir='rtl']) .back-link :global(.back-link__icon) {
    transform: scaleX(-1);
  }
</style>
