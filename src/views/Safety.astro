---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import IconTile from '../components/IconTile.astro';
import Icon from '../components/Icon.astro';
import Callout from '../components/Callout.astro';
import { localePath, routes, useDict, type Locale } from '../i18n';
import { rich } from '../lib/rich';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useDict(lang);
const c = t.safety;
const p = (r: string) => localePath(lang, r);
---

<Base lang={lang} title={c.title} description={c.description} route={routes.safety} current="safety">
  <PageHero title={c.hero.title} text={c.hero.text} />

  <section aria-label={c.promisesLabel} class="container promises-wrap">
    <ul class="plain promises">
      {
        c.promises.map((item) => (
          <li class="promise">
            <IconTile icon={item.icon} tone={item.tone} size={52} />
            <h2>{item.title}</h2>
            <p set:html={rich(item.text)} />
          </li>
        ))
      }
    </ul>
  </section>

  <!-- A. Encryption -->
  <section aria-label={c.encryption.label} class="band" id="encryption">
    <div class="container section">
      <div class="section-head section-head--row">
        <div class="section-head">
          <h2 class="display h2" set:html={rich(c.encryption.title)} />
          <p class="lead">{c.encryption.text}</p>
        </div>
      </div>
      <ul class="plain card-grid card-grid--3">
        {
          c.encryption.items.map((item) => (
            <li class="card card--white">
              <IconTile icon={item.icon} tone={item.tone} />
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- B. What is protected -->
  <section aria-label={c.protected.label} class="container section" id="protected">
    <div class="section-head">
      <h2 class="display h2" set:html={rich(c.protected.title)} />
      <p class="lead">{c.protected.text}</p>
    </div>
    <div class="protected">
      <table>
        <thead>
          <tr>
            <th scope="col">{c.protected.colWhat}</th>
            <th scope="col">{c.protected.colHow}</th>
          </tr>
        </thead>
        <tbody>
          {
            c.protected.rows.map((r) => (
              <tr>
                <th scope="row">{r.what}</th>
                <td>{r.how}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <a href={p(routes.safetyTechnical)} class="more-link">
        {c.moreLink}<Icon name="arrowRight" size={16} stroke={2} class="more-link__icon" />
      </a>
    </div>
  </section>

  <!-- C. What we can see, and when -->
  <section aria-label={c.oversight.label} class="container section oversight" id="oversight">
    <div class="section-head section-head--row">
      <div class="section-head">
        <h2 class="display h2" set:html={rich(c.oversight.title)} />
        <p class="lead">{c.oversight.text}</p>
      </div>
    </div>
    <ul class="plain card-grid card-grid--3">
      {
        c.oversight.items.map((item) => (
          <li class="card card--grey">
            <IconTile icon={item.icon} tone={item.tone} />
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- D. Abuse and fraud (replaces "Behind the scenes") -->
  <section aria-label={c.abuse.label} class="band" id="abuse">
    <div class="container section">
      <div class="section-head section-head--row">
        <div class="section-head">
          <h2 class="display h2" set:html={rich(c.abuse.title)} />
          <p class="lead">{c.abuse.text}</p>
        </div>
      </div>
      <ul class="plain card-grid card-grid--2">
        {
          c.abuse.items.map((item) => (
            <li class="card card--white card--text">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section aria-label={c.details.label} class="container details">
    <Callout title={c.details.title} text={c.details.text} cta={c.details.cta} href={p(routes.privacy)} />
  </section>

  <CtaBand lang={lang} />
</Base>

<style>
  .promises-wrap {
    padding-bottom: var(--section-y);
  }
  .promises {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  .promise {
    padding: 24px;
    border-radius: var(--radius-card);
    background: var(--bg);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .promise h2 {
    margin-top: 6px;
    font-size: 22px;
    font-weight: 600;
    line-height: 1.2;
  }
  .promise p {
    font-size: 16px;
    line-height: 1.45;
    color: var(--muted);
  }

  /* "Technical details" link next to each section heading. */
  .more-link {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 16px;
    font-weight: 600;
    text-underline-offset: 4px;
    white-space: nowrap;
  }
  .more-link:hover {
    color: var(--forest);
  }
  :global([dir='rtl']) .more-link :global(.more-link__icon) {
    transform: scaleX(-1);
  }

  .card-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  .card {
    padding: 24px;
    border-radius: var(--radius-card);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .card--white {
    background: var(--surface);
  }
  .card--grey {
    background: var(--bg);
  }
  .card--text {
    gap: 8px;
  }
  .card h3 {
    margin-top: 4px;
    font-size: 20px;
    font-weight: 600;
    line-height: 1.25;
  }
  .card--text h3 {
    margin-top: 0;
    font-size: 18px;
  }
  .card p {
    font-size: 15px;
    line-height: 1.5;
    color: var(--muted);
  }

  /* B. Table: rows stack into cards on phones. */
  .protected {
    max-width: 920px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .protected .more-link {
    align-self: flex-start;
  }
  .protected table {
    width: 100%;
    border-collapse: collapse;
  }
  .protected thead {
    display: none;
  }
  .protected tr {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .protected tbody tr:first-child {
    border-top: 1px solid var(--line);
  }
  .protected th,
  .protected td {
    padding: 0;
    text-align: start;
    vertical-align: top;
  }
  .protected tbody th {
    font-size: 16px;
    font-weight: 600;
  }
  .protected td {
    font-size: 15px;
    line-height: 1.5;
    color: var(--muted);
  }

  .oversight {
    padding-top: 0;
  }
  .details {
    padding-top: var(--section-y);
  }

  @media (min-width: 768px) {
    .promises,
    .card-grid--2,
    .card-grid--3 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .promise,
    .card {
      padding: 28px;
    }
    .card-grid--3 > :last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
    .protected thead {
      display: table-header-group;
    }
    .protected tr {
      display: table-row;
      padding: 0;
    }
    .protected thead th {
      padding: 12px 16px;
      background: var(--bg);
      font-size: 14px;
      font-weight: 600;
    }
    .protected thead th:first-child {
      border-start-start-radius: 12px;
      border-end-start-radius: 12px;
    }
    .protected thead th:last-child {
      border-start-end-radius: 12px;
      border-end-end-radius: 12px;
    }
    .protected tbody th,
    .protected tbody td {
      padding: 16px;
      border-bottom: 1px solid var(--line);
    }
    .protected tbody th {
      width: 34%;
    }
    .protected tbody tr:first-child {
      border-top: 0;
    }
  }
  @media (min-width: 1100px) {
    .promises,
    .card-grid--3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .card-grid--3 > :last-child:nth-child(odd) {
      grid-column: auto;
    }
  }
</style>
