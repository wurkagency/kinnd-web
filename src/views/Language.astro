---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import LanguageOptions from '../components/LanguageOptions.astro';
import { routes, useDict, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useDict(lang);
const c = t.language;
---

<!-- Fallback for the header language button when JavaScript is off. -->
<Base lang={lang} title={c.title} description={c.description} route={routes.language} noindex>
  <PageHero title={c.heading} text={c.text} />
  <section aria-label={c.listLabel} class="container language-list">
    <div class="language-list__inner">
      <LanguageOptions lang={lang} route={routes.home} />
    </div>
  </section>
</Base>

<style>
  .language-list {
    padding-bottom: var(--section-y);
  }
  .language-list__inner {
    max-width: 920px;
  }
</style>
