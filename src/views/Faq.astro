---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Callout from '../components/Callout.astro';
import { localePath, routes, useDict, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useDict(lang);
const c = t.faq;
---

<Base lang={lang} title={c.title} description={c.description} route={routes.faq} current="faq">
  <PageHero title={c.hero.title} text={c.hero.text} />

  <section aria-label={c.questionsLabel} class="container questions">
    <div class="groups">
      {
        c.groups.map((g) => (
          <section class="group" aria-label={g.title}>
            <h2 class="display">
              <em>{g.title}</em>
            </h2>
            <div class="group__items">
              {g.items.map((item) => (
                <div class="qa">
                  <h3>{item.q}</h3>
                  <p>{item.a}</p>
                </div>
              ))}
            </div>
          </section>
        ))
      }
    </div>
    <Callout
      title={c.more.title}
      text={c.more.text}
      cta={c.more.cta}
      href={`${localePath(lang, routes.about)}#contact`}
    />
  </section>

  <CtaBand lang={lang} />
</Base>

<style>
  .questions {
    display: flex;
    flex-direction: column;
    gap: var(--section-gap);
  }
  .groups {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  .group {
    padding: 20px 20px 4px;
    border-radius: var(--radius-card);
    background: var(--bg);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .group h2 {
    font-size: 30px;
    line-height: 1.1;
  }
  .qa {
    padding: 18px 0;
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .qa h3 {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.3;
  }
  .qa p {
    font-size: 15px;
    line-height: 1.5;
    color: var(--muted);
  }
  @media (min-width: 768px) {
    .group {
      padding: 28px 28px 8px;
    }
  }
  @media (min-width: 1000px) {
    .groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
