---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import MarkdownDoc from '../components/MarkdownDoc.astro';
import { localePath, routes, translatedLocales, useDict, type Locale } from '../i18n';

type Doc = 'privacy' | 'terms' | 'cookies';
interface Props {
  lang: Locale;
  doc: Doc;
}
const { lang, doc } = Astro.props;
const t = useDict(lang);
const l = t.legal;
const c = l[doc];
const docs: Doc[] = ['privacy', 'terms', 'cookies'];

/**
 * Final legal texts live in src/content/legal/<lang>/<doc>.md (from counsel).
 * A language without its own file shows the English text. That page is noindex
 * and left out of hreflang and the sitemap (see astro.config.mjs).
 */
const files = import.meta.glob<import('astro').MarkdownInstance<{ title: string; updated: string }>>(
  '../content/legal/*/*.md',
  { eager: true },
);
const file = (l: Locale) => files[`../content/legal/${l}/${doc}.md`];
const md = file(lang) ?? file('en');
// The English text on a non-English page: tell browsers and screen readers.
const bodyLang = file(lang) || lang === 'en' ? undefined : 'en';
const alternates = translatedLocales().filter((l) => file(l));
---

<Base lang={lang} title={c.title} description={c.description} route={routes[doc]} alternates={alternates}>
  <PageHero title={c.heading} text={c.text}>
    <!-- Separate pages, so this is a link row, not an ARIA tab widget. -->
    <nav class="doc-tabs" aria-label={l.tabsLabel}>
      {
        docs.map((d) => (
          <a href={localePath(lang, routes[d])} aria-current={d === doc ? 'page' : undefined}>
            {l[d].tab}
          </a>
        ))
      }
    </nav>
  </PageHero>

  <MarkdownDoc md={md} label={l[doc].tab} tocLabel={l.onThisPage} lang={bodyLang} intro={md.frontmatter.updated} />
</Base>

<style>
  .doc-tabs {
    align-self: flex-start;
    max-width: 100%;
    display: flex;
    padding: 4px;
    border-radius: 14px;
    background: var(--bg);
    flex-wrap: wrap;
  }
  .doc-tabs a {
    height: 44px;
    padding: 0 14px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .doc-tabs a:hover {
    color: var(--forest);
  }
  .doc-tabs a[aria-current='page'] {
    background: var(--ink);
    color: #fff;
  }
  @media (min-width: 768px) {
    .doc-tabs a {
      padding: 0 20px;
    }
  }
</style>
