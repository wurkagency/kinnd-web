---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LanguageDialog from '../components/LanguageDialog.astro';
import {
  locales,
  localePath,
  useDict,
  defaultLocale,
  isUntranslated,
  localeInfo,
  translatedLocales,
  routes,
  site as company,
  APP_URL,
  type Locale,
} from '../i18n';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  /** Route without locale prefix, e.g. "/features/". Omit for pages without alternates (404). */
  route?: string;
  /** Route key used to mark the current header link. */
  current?: string;
  noindex?: boolean;
  /**
   * Languages that have this page in their own language. Defaults to every
   * translated language. A page shown in a language outside this list (English
   * text on a German page, say) is noindex and left out of the hreflang set.
   */
  alternates?: Locale[];
  /**
   * Route the language dialog links to. Defaults to `route`. Pages that only
   * exist in one language (the Danish articles) send the other languages home.
   */
  languageRoute?: string;
}
const {
  lang,
  title,
  description,
  route,
  current,
  noindex = false,
  alternates = translatedLocales(),
  languageRoute,
} = Astro.props;
const t = useDict(lang);
const site = Astro.site!;
const abs = (path: string) => new URL(path, site).href;
const canonical = route ? abs(localePath(lang, route)) : undefined;
const indexable = !noindex && !isUntranslated(lang) && alternates.includes(lang);
const robots = indexable ? undefined : 'noindex, follow';
const hreflangs = route && indexable ? locales.filter((l) => alternates.includes(l)) : [];

/**
 * Structured data (schema.org JSON-LD): who runs KINND, the site, this page and
 * where it sits. The app and its plans are described on the pages that sell it.
 */
const orgId = abs('/#organization');
const pageName = title.replace(/\s*·\s*KINND$/, '').replace(/^KINND\s*·\s*/, '');
const plans = t.pricing.plans;
const graph: Record<string, unknown>[] = [
  {
    '@type': 'Organization',
    '@id': orgId,
    name: company.name,
    legalName: 'WURK ApS',
    url: abs('/'),
    logo: { '@type': 'ImageObject', url: abs('/apple-touch-icon.png'), width: 180, height: 180 },
    email: company.contactEmail,
    identifier: { '@type': 'PropertyValue', propertyID: 'CVR', value: '37547395' },
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Skoleholdervej 91',
      postalCode: '2400',
      addressLocality: 'København NV',
      addressCountry: 'DK',
    },
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'customer support',
      email: company.safetyEmail,
      availableLanguage: ['da', 'en'],
    },
  },
  {
    '@type': 'WebSite',
    '@id': abs('/#website'),
    url: abs('/'),
    name: company.name,
    publisher: { '@id': orgId },
    inLanguage: translatedLocales(),
  },
];
if (canonical && indexable) {
  graph.push({
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: pageName,
    description,
    inLanguage: lang,
    isPartOf: { '@id': abs('/#website') },
    about: { '@id': orgId },
  });
  if (route !== routes.home) {
    const crumbs: { name: string; path: string }[] = [{ name: company.name, path: routes.home }];
    if (route!.startsWith(routes.safety) && route !== routes.safety) crumbs.push({ name: t.nav.safetyLong, path: routes.safety });
    if (route!.startsWith('/artikler/') && route !== '/artikler/') crumbs.push({ name: t.nav.articles, path: '/artikler/' });
    crumbs.push({ name: pageName, path: route! });
    graph.push({
      '@type': 'BreadcrumbList',
      itemListElement: crumbs.map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.name,
        item: abs(localePath(lang, c.path)),
      })),
    });
  }
  if (route === routes.home || route === routes.features || route === routes.pricing) {
    const offer = (name: string, price: string) => ({ '@type': 'Offer', name, price, priceCurrency: 'DKK' });
    graph.push({
      '@type': 'WebApplication',
      name: company.name,
      url: APP_URL,
      applicationCategory: 'LifestyleApplication',
      operatingSystem: 'Any (runs in the browser)',
      inLanguage: translatedLocales(),
      publisher: { '@id': orgId },
      offers: [
        offer(plans.free.name, plans.free.price),
        offer(plans.parents.name, plans.parents.monthly.price),
        offer(plans.family.name, plans.family.monthly.price),
      ],
    });
  }
}
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
const ogLocale = localeInfo[lang].og;
const ogImage = abs('/og-default.png');
// Fonts the first screen needs, so text does not reflow (layout shift) when they arrive.
const preloadFonts =
  lang === 'ar'
    ? ['noto-sans-arabic-arabic-400-normal', 'noto-sans-arabic-arabic-600-normal', 'albert-sans-latin-400-normal']
    : [
        'albert-sans-latin-400-normal',
        'albert-sans-latin-600-normal',
        'instrument-serif-latin-400-normal',
        'instrument-serif-latin-400-italic',
      ];
---

<!doctype html>
<html lang={lang} dir={localeInfo[lang].dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      Language on entry (runs before the page paints). Only when the visitor
      arrives from outside the site, never on internal navigation:
      1. A language the visitor picked before (localStorage) wins.
      2. Otherwise guess from location (time zone), then the browser language,
         and only switch to a language that is translated.
      The header language button is always there to change it back.
    -->
    <script is:inline define:vars={{ L: locales, T: translatedLocales() }}>
      try {
        var KEY = 'kinnd-lang';
        var parts = location.pathname.split('/');
        var cur = L.indexOf(parts[1]) > 0 ? parts[1] : 'en';
        var rest = cur === 'en' ? location.pathname : location.pathname.slice(cur.length + 1);
        var internal = document.referrer && new URL(document.referrer).host === location.host;
        if (!internal && rest.indexOf('/language/') !== 0) {
          var target = localStorage.getItem(KEY);
          if (!target && !navigator.webdriver && !/bot|crawl|spider|slurp|lighthouse/i.test(navigator.userAgent)) {
            var TZ = {
              'Europe/Copenhagen': 'da', 'America/Nuuk': 'da', 'Atlantic/Faroe': 'fo', 'Atlantic/Reykjavik': 'is',
              'Europe/Oslo': 'no', 'Arctic/Longyearbyen': 'no', 'Europe/Stockholm': 'sv',
              'Europe/Berlin': 'de', 'Europe/Busingen': 'de', 'Europe/Vienna': 'de', 'Europe/Zurich': 'de', 'Europe/Vaduz': 'de',
              'Europe/Istanbul': 'tr', 'Asia/Istanbul': 'tr',
              'Europe/London': 'en', 'Europe/Dublin': 'en'
            };
            var AR = /^(Asia\/(Riyadh|Dubai|Qatar|Kuwait|Bahrain|Muscat|Baghdad|Amman|Beirut|Damascus|Aden|Gaza|Hebron)|Africa\/(Cairo|Algiers|Tunis|Tripoli|Casablanca|Khartoum))$/;
            var tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
            target = TZ[tz] || (AR.test(tz) ? 'ar' : '');
            if (!target) {
              var langs = navigator.languages || [navigator.language || ''];
              for (var i = 0; i < langs.length && !target; i++) {
                var c = String(langs[i]).toLowerCase().split('-')[0];
                if (c === 'nb' || c === 'nn') c = 'no';
                if (L.indexOf(c) >= 0) target = c;
              }
            }
            if (T.indexOf(target) < 0 && target !== 'en') target = '';
          }
          if (target && target !== cur && L.indexOf(target) >= 0) {
            location.replace((target === 'en' ? '' : '/' + target) + rest + location.search + location.hash);
          }
        }
      } catch (e) {}
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {hreflangs.map((l) => <link rel="alternate" hreflang={l} href={abs(localePath(l, route!))} />)}
    {
      hreflangs.includes(defaultLocale) && (
        <link rel="alternate" hreflang="x-default" href={abs(localePath(defaultLocale, route!))} />
      )
    }

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0F3D35" />

    {preloadFonts.map((f) => <link rel="preload" href={`/fonts/${f}.woff2`} as="font" type="font/woff2" crossorigin />)}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="KINND" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.site.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" is:inline set:html={jsonLd} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.nav.skip}</a>
    <Header lang={lang} current={current} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <LanguageDialog lang={lang} route={languageRoute ?? route ?? '/'} />
    <script>
      // Remember an explicit language choice for the next visit.
      document.addEventListener('click', (e) => {
        const option = (e.target as Element).closest<HTMLElement>('[data-lang-option]');
        if (!option) return;
        try {
          localStorage.setItem('kinnd-lang', option.dataset.langOption!);
        } catch {}
      });
    </script>
  </body>
</html>
