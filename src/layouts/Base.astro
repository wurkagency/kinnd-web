---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { locales, localePath, useDict, defaultLocale, type Locale } from '../i18n';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  /** Route without locale prefix, e.g. "/features/". Omit for pages without alternates (404). */
  route?: string;
  /** Route key used to mark the current header link. */
  current?: string;
  noindex?: boolean;
}
const { lang, title, description, route, current, noindex = false } = Astro.props;
const t = useDict(lang);
const site = Astro.site!;
const abs = (path: string) => new URL(path, site).href;
const canonical = route ? abs(localePath(lang, route)) : undefined;
const robots = noindex || t.meta.untranslated ? 'noindex, follow' : undefined;
const ogLocale = { en: 'en_GB', da: 'da_DK', sv: 'sv_SE' }[lang];
const ogImage = abs('/og-default.png');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {
      route &&
        locales.map((l) => <link rel="alternate" hreflang={l} href={abs(localePath(l, route))} />)
    }
    {route && <link rel="alternate" hreflang="x-default" href={abs(localePath(defaultLocale, route))} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0F3D35" />

    <link rel="preload" href="/fonts/albert-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-serif-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="KINND" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.site.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.nav.skip}</a>
    <Header lang={lang} route={route ?? '/'} current={current} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} route={route ?? '/'} />
  </body>
</html>
