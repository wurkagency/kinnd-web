---
import Icon from './Icon.astro';
import { localeInfo, localePath, routes, useDict, type Locale } from '../i18n';

interface Props {
  lang: Locale;
  /** "header": code + chevron. "footer": pill with the language name. */
  variant?: 'header' | 'footer';
}
const { lang, variant = 'header' } = Astro.props;
const t = useDict(lang);
---

<!-- A link to the language page; with JavaScript it opens the language dialog instead. -->
<a
  href={localePath(lang, routes.language)}
  class:list={['lang-btn', `lang-btn--${variant}`]}
  aria-label={`${t.nav.language}: ${localeInfo[lang].name}`}
  aria-haspopup="dialog"
  aria-expanded="false"
  data-lang-open
>
  {variant === 'footer' && <Icon name="globe" size={18} />}
  <span aria-hidden="true">{variant === 'header' ? lang.toUpperCase() : localeInfo[lang].name}</span>
  <Icon name="chevronDown" size={14} stroke={2} />
</a>

<style>
  .lang-btn {
    height: 44px;
    border-radius: var(--radius-control);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .lang-btn--header {
    padding: 0 10px;
  }
  .lang-btn--header:hover {
    background: var(--bg);
  }
  .lang-btn--footer {
    padding: 0 14px;
    border: 1.5px solid var(--ink);
    font-size: 14px;
    gap: 8px;
  }
  .lang-btn--footer:hover {
    background: var(--surface);
  }
</style>
