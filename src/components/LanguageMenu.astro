---
import Icon from './Icon.astro';
import { locales, localePath, useDict, type Locale } from '../i18n';

interface Props {
  lang: Locale;
  /** Route of the current page without locale prefix. */
  route: string;
}
const { lang, route } = Astro.props;
const t = useDict(lang);
---

<details class="lang-menu" data-lang-menu>
  <summary aria-label={`${t.nav.language}: ${t.nav.languageNames[lang]}`}>
    <span aria-hidden="true">{lang.toUpperCase()}</span>
    <Icon name="chevronDown" size={14} stroke={2} class="lang-menu__chevron" />
  </summary>
  <ul class="lang-menu__list plain">
    {
      locales.map((l) => (
        <li>
          <a href={localePath(l, route)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>
            <span class="lang-menu__code" aria-hidden="true">
              {l.toUpperCase()}
            </span>
            {t.nav.languageNames[l]}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<script>
  // Close on Escape and on click outside. The menu itself works without this.
  const menus = document.querySelectorAll<HTMLDetailsElement>('[data-lang-menu]');
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    menus.forEach((m) => {
      if (m.open) {
        m.open = false;
        m.querySelector('summary')?.focus();
      }
    });
  });
  document.addEventListener('click', (e) => {
    menus.forEach((m) => {
      if (m.open && !m.contains(e.target as Node)) m.open = false;
    });
  });
</script>

<style>
  .lang-menu {
    position: relative;
  }
  summary {
    height: 44px;
    padding: 0 10px;
    border-radius: var(--radius-control);
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    background: var(--bg);
  }
  :global(.lang-menu__chevron) {
    transition: transform 150ms ease;
  }
  .lang-menu[open] :global(.lang-menu__chevron) {
    transform: rotate(180deg);
  }
  .lang-menu__list {
    position: absolute;
    right: 0;
    top: calc(100% + 6px);
    z-index: 20;
    min-width: 168px;
    padding: 6px;
    border-radius: 16px;
    background: var(--surface);
    box-shadow:
      0 0 0 1px var(--line),
      0 12px 28px rgba(20, 32, 25, 0.12);
  }
  .lang-menu__list a {
    min-height: 44px;
    padding: 0 12px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 15px;
    text-decoration: none;
  }
  .lang-menu__list a:hover {
    background: var(--bg);
  }
  .lang-menu__list a[aria-current] {
    font-weight: 600;
    background: var(--bg);
  }
  .lang-menu__code {
    width: 22px;
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
  }
</style>
