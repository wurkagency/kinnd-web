---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import Button from './Button.astro';
import { localePath, useDict, APP_URL, type Locale } from '../i18n';

interface NavItem {
  key: string;
  href: string;
  label: string;
}
interface Props {
  lang: Locale;
  items: NavItem[];
  current?: string;
}
const { lang, items, current } = Astro.props;
const t = useDict(lang);
---

<dialog id="mobile-menu" class="mobile-menu" aria-label={t.nav.menuTitle}>
  <div class="mobile-menu__top">
    <a href={localePath(lang, '/')} aria-label={t.nav.home} class="mobile-menu__logo"><Logo /></a>
    <button
      type="button"
      class="menu-btn"
      commandfor="mobile-menu"
      command="close"
      aria-label={t.nav.closeMenu}
      data-menu-close
    >
      <Icon name="close" size={20} stroke={2} />
    </button>
  </div>
  <nav aria-label={t.nav.mainLabel}>
    <ul class="mobile-menu__list plain">
      {
        items.map((item) => (
          <li>
            <a href={item.href} aria-current={item.key === current ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <Button href={APP_URL} fill>{t.cta.tryFree}</Button>
</dialog>

<script>
  // A modal <dialog> gives Escape-to-close and an inert page behind it, so focus
  // stays inside. Scroll lock is CSS (html:has(dialog[open])). This script covers
  // browsers without Invoker Commands (commandfor/command) and keeps aria-expanded
  // in sync.
  const dialog = document.getElementById('mobile-menu') as HTMLDialogElement | null;
  const opener = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  if (dialog && opener) {
    if (!('command' in HTMLButtonElement.prototype)) {
      opener.addEventListener('click', () => dialog.showModal());
      dialog.querySelector('[data-menu-close]')?.addEventListener('click', () => dialog.close());
    }
    dialog.addEventListener('toggle', () => opener.setAttribute('aria-expanded', String(dialog.open)));
    dialog.addEventListener('close', () => opener.setAttribute('aria-expanded', 'false'));
    // Close when the viewport grows past the mobile breakpoint.
    matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
      if (e.matches && dialog.open) dialog.close();
    });
  }
</script>

<style>
  .mobile-menu {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 12px 16px 32px;
    border: 0;
    background: var(--surface);
    color: var(--ink);
    flex-direction: column;
    gap: 24px;
  }
  .mobile-menu[open] {
    display: flex;
  }
  .mobile-menu::backdrop {
    background: rgba(20, 32, 25, 0.4);
  }
  .mobile-menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .mobile-menu__logo {
    min-height: 44px;
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  .mobile-menu__list {
    display: flex;
    flex-direction: column;
  }
  .mobile-menu__list li + li {
    border-top: 1px solid var(--line);
  }
  .mobile-menu__list a {
    min-height: 64px;
    display: flex;
    align-items: center;
    font-family: var(--font-serif);
    font-size: 34px;
    line-height: 1.1;
    text-decoration: none;
  }
  .mobile-menu__list a[aria-current='page'] {
    font-style: italic;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 8px;
  }
  .mobile-menu :global(.btn) {
    margin-top: auto;
  }
  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu[open] {
      animation: menu-in 200ms ease-out;
    }
    @keyframes menu-in {
      from {
        opacity: 0;
        transform: translateY(-8px);
      }
    }
  }
</style>
