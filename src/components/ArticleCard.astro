---
import { Picture } from 'astro:assets';
import { articlePath, formatDate, type Article } from '../lib/articles';
import { useDict } from '../i18n';

interface Props {
  article: Article;
  /** "feature": the large card at the top of the overview. */
  variant?: 'card' | 'feature';
  /** Heading level of the card title in its context. */
  level?: 2 | 3;
  eager?: boolean;
}
const { article: a, variant = 'card', level = 3, eager = false } = Astro.props;
const t = useDict('da').articles;
const Heading = `h${level}` as 'h2' | 'h3';
const meta = `${formatDate(a.date)} · ${a.reading_time} ${t.minRead}`;
---

<a href={articlePath(a.slug)} class:list={['article-card', `article-card--${variant}`]}>
  <span class="article-card__media">
    <Picture
      src={a.hero}
      alt=""
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={variant === 'feature' ? [480, 720, 1000, 1400] : [400, 600, 800]}
      sizes={variant === 'feature' ? '(min-width: 1100px) 520px, (min-width: 768px) 60vw, 100vw' : '(min-width: 1100px) 400px, (min-width: 768px) 45vw, 100vw'}
      quality={60}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
    />
  </span>
  <span class="article-card__body">
    <span class:list={['tag', `tag--${a.categoryInfo.tone}`]}>{a.category}</span>
    <Heading class="article-card__title">{a.title}</Heading>
    <span class="article-card__text">{a.description}</span>
    <span class="article-card__foot">
      <span class="article-card__meta">{meta}</span>
      {variant === 'feature' && <span class="article-card__more">{t.readArticle}</span>}
    </span>
  </span>
</a>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    color: var(--ink);
    text-decoration: none;
  }
  .article-card__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    border-radius: 18px;
    overflow: hidden;
    background: var(--bg);
  }
  .article-card__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }
  .article-card:hover .article-card__media :global(img) {
    transform: scale(1.03);
  }
  .article-card__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .article-card__title {
    font-size: 21px;
    font-weight: 600;
    line-height: 1.25;
  }
  .article-card:hover .article-card__title {
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 4px;
  }
  .article-card__text {
    font-size: 15px;
    line-height: 1.55;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .article-card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .article-card__meta {
    font-size: 13px;
    color: var(--muted);
  }
  .article-card__more {
    font-size: 15px;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* Feature card: image and text side by side on a grey card. */
  .article-card--feature {
    gap: 0;
    border-radius: 24px;
    overflow: hidden;
    background: var(--bg);
  }
  .article-card--feature .article-card__media {
    border-radius: 0;
  }
  .article-card--feature .article-card__body {
    padding: 24px;
    gap: 14px;
  }
  .article-card--feature .article-card__title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(30px, calc(24.4px + 1.143vw), 40px);
    line-height: 1.05;
  }
  .article-card--feature .article-card__text {
    font-size: 16px;
    -webkit-line-clamp: 4;
  }
  @media (min-width: 768px) {
    .article-card--feature {
      display: grid;
      grid-template-columns: 1.15fr 1fr;
    }
    .article-card--feature .article-card__media {
      aspect-ratio: auto;
      min-height: 380px;
    }
    .article-card--feature .article-card__body {
      padding: 36px;
      justify-content: center;
      gap: 16px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .article-card__media :global(img) {
      transition: none;
    }
  }
</style>
