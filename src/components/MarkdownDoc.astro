---
/**
 * A long Markdown document with an "On this page" list: the legal texts and the
 * technical Safety pages. The list is built from the document's own h2 headings;
 * a leading "1." becomes the number column.
 */
import type { MarkdownInstance } from 'astro';

interface Props {
  md: MarkdownInstance<Record<string, unknown>>;
  /** aria-label for the section. */
  label: string;
  /** "On this page" in the page language. */
  tocLabel: string;
  /** Set when the text is in another language than the page (e.g. English text on a German page). */
  lang?: string;
  /** Small muted line above the text, e.g. "Last updated: …". */
  intro?: string;
}
const { md, label, tocLabel, lang, intro } = Astro.props;
const toc = md
  .getHeadings()
  .filter((h) => h.depth === 2)
  .map((h) => {
    const m = h.text.match(/^(\d+)\.\s*(.*)$/);
    return { slug: h.slug, num: m ? m[1] : '', text: m ? m[2] : h.text };
  });
const numbered = toc.some((h) => h.num);
const dir = lang ? 'ltr' : undefined;
const { Content } = md;
---

<section aria-label={label} class="container md-doc">
  <nav class="toc" aria-label={tocLabel}>
    <span class="toc__title">{tocLabel}</span>
    {
      toc.map((h) => (
        <a href={`#${h.slug}`} lang={lang} dir={dir}>
          {numbered && <span class="toc__num">{h.num}</span>}
          <span>{h.text}</span>
        </a>
      ))
    }
  </nav>
  <div class="md-doc__body" lang={lang} dir={dir}>
    {intro && <p class="md-doc__intro">{intro}</p>}
    <Content />
    <slot />
  </div>
</section>

<style>
  .md-doc {
    padding-bottom: var(--section-y);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .toc {
    width: 100%;
    padding: 20px;
    border-radius: var(--radius-card);
    background: var(--bg);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .toc__title {
    padding-bottom: 8px;
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
  }
  .toc a {
    min-height: 40px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    text-decoration: none;
  }
  .toc a:hover {
    color: var(--forest);
    text-decoration: underline;
  }
  .toc__num {
    width: 20px;
    flex-shrink: 0;
    font-size: 13px;
    color: var(--muted);
  }
  .md-doc__body {
    flex: 1;
    min-width: 0;
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .md-doc__intro {
    font-size: 13px;
    color: var(--muted);
  }
  .md-doc__body :global(h2) {
    margin-top: 24px;
    font-size: 22px;
    font-weight: 600;
    line-height: 1.25;
    scroll-margin-top: 16px;
  }
  .md-doc__body :global(h3) {
    margin-top: 8px;
    font-size: 17px;
    font-weight: 600;
    line-height: 1.3;
  }
  .md-doc__body :global(p),
  .md-doc__body :global(li) {
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
  }
  .md-doc__body :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }
  .md-doc__body :global(ul),
  .md-doc__body :global(ol) {
    margin: 0;
    padding-inline-start: 22px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .md-doc__body :global(a) {
    color: var(--ink);
    font-weight: 500;
    overflow-wrap: anywhere;
  }
  .md-doc__body :global(a:hover) {
    color: var(--forest);
  }
  .md-doc__body :global(code) {
    padding: 1px 6px;
    border-radius: 6px;
    background: var(--bg);
    color: var(--ink);
    font-size: 0.92em;
  }
  .md-doc__body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    line-height: 1.45;
  }
  .md-doc__body :global(th),
  .md-doc__body :global(td) {
    padding: 10px 12px;
    text-align: start;
    vertical-align: top;
    border-bottom: 1px solid var(--line);
  }
  .md-doc__body :global(th) {
    background: var(--bg);
    font-weight: 600;
  }
  .md-doc__body :global(td) {
    color: var(--muted);
  }
  /* Tables scroll inside themselves on small screens, never the page. */
  @media (max-width: 767.98px) {
    .md-doc__body :global(table) {
      display: block;
      overflow-x: auto;
    }
    .md-doc__body :global(th),
    .md-doc__body :global(td) {
      min-width: 140px;
    }
  }
  @media (min-width: 960px) {
    .md-doc {
      flex-direction: row;
      align-items: flex-start;
      gap: 64px;
    }
    .toc {
      position: sticky;
      top: 24px;
      width: 280px;
      flex-shrink: 0;
    }
  }
</style>
