---
import { Picture } from 'astro:assets';
import screen from '../assets/today-screen-blurred.png';

interface Props {
  label: string;
  callouts: string[];
}
const { label, callouts } = Astro.props;
---

<div class="phone-host">
<div class="phone-stage">
  <div class="phone-wrap">
    <div class="phone" role="img" aria-label={label}>
      <div class="phone__screen" aria-hidden="true">
        <Picture
          src={screen}
          alt=""
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          widths={[240, 280, 480, 560, 724]}
          sizes="(min-width: 768px) 280px, 234px"
          quality={70}
          loading="eager"
          decoding="async"
        />
        <span class="phone__notch"></span>
      </div>
    </div>
    <ol class="callouts plain">
      {
        callouts.map((text, i) => (
          <li class={`callout callout--${i + 1}`}>
            <span class="callout__pill">{text}</span>
            <span class="callout__num" aria-hidden="true">
              {i + 1}
            </span>
          </li>
        ))
      }
    </ol>
  </div>
</div>
</div>

<style>
  /*
   * The phone sits at the top of the stage and runs off the bottom edge of the
   * hero panel (the panel clips it). Callouts are positioned against the phone
   * box itself, so they stay attached at every width.
   */
  .phone-host {
    container-type: inline-size;
    width: 100%;
  }
  .phone-stage {
    --pw: min(250px, calc(100cqw - 24px));
    --ph: calc(var(--pw) * 2.24);
    --pad: 8px;
    --r-out: 46px;
    --r-in: 38px;
    /* How far side callouts may reach past the phone edge. */
    --reach: min(40px, calc(max(12px, (100cqw - 250px) / 2) + 6px));
    position: relative;
    width: 100%;
    margin-inline: auto;
    height: calc(var(--ph) - 60px);
  }
  .phone-wrap {
    position: absolute;
    left: 50%;
    top: 0;
    width: var(--pw);
    height: var(--ph);
    transform: translateX(-50%);
  }
  .phone {
    width: 100%;
    height: 100%;
    padding: var(--pad);
    border-radius: var(--r-out);
    background: var(--ink);
    box-shadow:
      0 0 0 1.5px rgba(255, 255, 255, 0.28),
      0 24px 48px rgba(0, 0, 0, 0.45);
  }
  .phone__screen {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: var(--r-in);
    overflow: hidden;
    background: var(--bg);
  }
  .phone__screen :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
  }
  .phone__notch {
    position: absolute;
    left: 50%;
    top: 8px;
    width: 30%;
    height: 22px;
    transform: translateX(-50%);
    border-radius: 13px;
    background: var(--ink);
  }

  .callout {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .callout__pill {
    height: 34px;
    padding: 0 14px;
    border-radius: 17px;
    background: var(--surface);
    color: var(--ink);
    display: flex;
    align-items: center;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
  }
  .callout__num {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    border-radius: 9px 9px 9px 2px;
    background: var(--orange);
    color: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 600;
  }
  /* Right-hand callouts: number first, tail points the other way. */
  .callout--2,
  .callout--4 {
    flex-direction: row-reverse;
  }
  .callout--2 .callout__num,
  .callout--4 .callout__num {
    border-radius: 9px 9px 2px 9px;
  }
  .callout--1 { left: calc(-1 * var(--reach)); top: 47.9%; }
  .callout--2 { right: calc(-1 * var(--reach)); top: 61.1%; }
  .callout--3 { left: calc(-1 * var(--reach)); top: 71.4%; }
  .callout--4 { right: calc(-1 * var(--reach)); top: 80.7%; }

  @media (min-width: 768px) {
    .phone-stage {
      --pw: 300px;
      --ph: 670px;
      --pad: 10px;
      --r-out: 54px;
      --r-in: 44px;
      max-width: 560px;
      height: 640px;
    }
    .phone__notch {
      top: 10px;
      height: 26px;
    }
    .callout {
      gap: 10px;
    }
    .callout__pill {
      height: 40px;
      padding: 0 18px;
      border-radius: 20px;
      font-size: 14px;
    }
    .callout__num {
      width: 28px;
      height: 28px;
      border-radius: 10px 10px 10px 2px;
      font-size: 13px;
    }
    .callout--2 .callout__num,
    .callout--4 .callout__num {
      border-radius: 10px 10px 2px 10px;
    }
    /* Offsets from the desktop board, measured against the phone box. */
    .callout--1 { left: -94px; top: 330px; }
    .callout--2 { right: -76px; top: 420px; }
    .callout--3 { left: -106px; top: 491px; }
    .callout--4 { right: -138px; top: 550px; }
  }
</style>
