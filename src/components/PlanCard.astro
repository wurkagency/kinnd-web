---
import Icon from './Icon.astro';
import Button from './Button.astro';
import { APP_URL } from '../i18n';
import { rich } from '../lib/rich';

interface Price {
  price: string;
  unit: string;
  note: string;
}
interface Props {
  name: string;
  text: string;
  badge?: string;
  /** Free has one price; paid plans have monthly and yearly. */
  monthly: Price;
  yearly?: Price;
  features: string[];
  excluded?: string;
  cta: string;
  ctaVariant?: 'forest' | 'lilac' | 'white';
  dark?: boolean;
}
const { name, text, badge, monthly, yearly, features, excluded, cta, ctaVariant = 'forest', dark = false } = Astro.props;
---

<article class:list={['plan', { 'plan--dark on-dark': dark }]}>
  <div class="plan__head">
    <div class="plan__name-row">
      <h2>{name}</h2>
      {badge && <span class="plan__badge">{badge}</span>}
    </div>
    <p class="plan__text">{text}</p>
  </div>
  <div class="plan__price">
    <div data-period="monthly">
      <span class="plan__amount"><span class="plan__num">{monthly.price}</span><span>{monthly.unit}</span></span>
      <span class="plan__note" set:html={rich(monthly.note)} />
    </div>
    {
      yearly && (
        <div data-period="yearly" hidden>
          <span class="plan__amount">
            <span class="plan__num">{yearly.price}</span>
            <span>{yearly.unit}</span>
          </span>
          <span class="plan__note" set:html={rich(yearly.note)} />
        </div>
      )
    }
  </div>
  <ul class="plain plan__features">
    {
      features.map((f) => (
        <li>
          <Icon name="check" size={16} />
          <span>{f}</span>
        </li>
      ))
    }
  </ul>
  {excluded && <p class="plan__excluded">{excluded}</p>}
  <div class="plan__cta">
    <Button href={APP_URL} variant={ctaVariant} fill>{cta}</Button>
  </div>
</article>

<style>
  .plan {
    padding: 24px;
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow: 0 0 0 1px var(--line);
    display: flex;
    flex-direction: column;
    gap: 22px;
    --check: var(--forest);
    --sub: var(--muted);
    --rule: var(--line-strong);
  }
  .plan--dark {
    background: var(--forest);
    color: #fff;
    box-shadow: none;
    --check: var(--mint);
    --sub: var(--forest-muted);
    --rule: rgba(255, 255, 255, 0.35);
  }
  .plan__head {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .plan__name-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .plan h2 {
    font-size: 22px;
    font-weight: 600;
  }
  .plan__badge {
    height: 26px;
    padding: 0 10px;
    border-radius: 8px;
    background: var(--orange);
    color: var(--ink);
    display: flex;
    align-items: center;
    font-size: 12px;
    font-weight: 700;
  }
  .plan__text {
    font-size: 15px;
    line-height: 1.4;
    color: var(--sub);
  }
  .plan__price {
    padding-bottom: 20px;
    border-bottom: 1px dashed var(--rule);
  }
  .plan__price > div {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .plan__price > div[hidden] {
    display: none;
  }
  .plan__amount {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 16px;
  }
  .plan__num {
    font-family: var(--font-serif);
    font-size: 64px;
    line-height: 0.9;
  }
  .plan__note {
    font-size: 13px;
    color: var(--sub);
  }
  .plan__features {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .plan__features li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 15px;
    line-height: 1.4;
  }
  .plan__features :global(svg) {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--check);
  }
  .plan__excluded {
    font-size: 13px;
    line-height: 1.45;
    color: var(--sub);
  }
  .plan__cta {
    margin-top: auto;
    display: flex;
    flex-direction: column;
  }
  @media (min-width: 768px) {
    .plan {
      padding: 28px;
    }
  }
</style>
